# Copiez ce fichier en « .env » (jamais versionné). Aucun secret ne doit être mis ailleurs.

# --- Serveur ---------------------------------------------------------------
HOST=127.0.0.1                 # n'exposez pas le serveur sans reverse proxy + authentification
PORT=8787
DB_PATH=./data/flux-macron.sqlite
DEMO_MODE=false                # true : données de démonstration FICTIVES, aucune collecte
REFRESH_INTERVAL_MINUTES=30    # minimum 10
MIN_MANUAL_REFRESH_SECONDS=60
RETENTION_DAYS=45
HTTP_CONTACT=                  # e-mail ou URL de contact ajouté au User-Agent (recommandé)

# --- Administration (corrections manuelles) --------------------------------
# Sans ADMIN_TOKEN, les routes PATCH/POST d'administration sont désactivées.
ADMIN_TOKEN=

# Comptes X traités comme « sources primaires » dans l'indice de recoupement
OFFICIAL_ACCOUNTS=EmmanuelMacron,Elysee

# --- Source : X (API officielle v2) ----------------------------------------
X_BEARER_TOKEN=                # jeton d'application, lecture seule — côté serveur uniquement
X_ACCOUNTS=EmmanuelMacron
X_MAX_POSTS_PER_REFRESH=20     # 5–100 ; borne le coût de lecture

# --- Source : Google Actualités (flux RSS public, sans API officielle) -----
GOOGLE_NEWS_RSS_ENABLED=false  # passez à true APRÈS avoir lu docs/SOURCES.md
GOOGLE_NEWS_QUERY="Emmanuel Macron"
GOOGLE_NEWS_LANGUAGE=fr
GOOGLE_NEWS_COUNTRY=FR

# --- Filtre « Personnalités » ---------------------------------------------
# Personnes à repérer dans les titres et extraits collectés (mention exacte, sans devinette).
# Format : Nom complet|alias1|alias2 ; Autre nom|alias  — vide = filtre inactif.
# Choisissez et vérifiez vous-même cette liste (fonctions, orthographes) ; aucune n'est fournie par défaut.
PERSONALITIES=
