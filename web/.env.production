# Variables de build pour Vercel. Commitées volontairement.
#
# Vite inline les VITE_* dans le bundle : cette clé est déjà servie à chaque
# visiteur dans /assets/index-*.js. La commiter n'ajoute donc aucune exposition,
# et rend le build reproductible depuis le dépôt sans configuration manuelle.
#
# C'est la clé *publishable*, prévue pour le navigateur : les policies RLS ne
# l'autorisent qu'à lire `entries` et `topics`. Un INSERT anonyme renvoie 401.
# Le mot de passe Postgres, lui, ne quitte jamais .env à la racine.
VITE_SUPABASE_URL=https://sqjxovnibpxwmeavfncr.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_zNalvfhj42OUkQ9FWMW3jQ_M96xL2uH
